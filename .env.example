# Project Unlocked - Discovery Agent Environment Configuration
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit your real .env file or API keys to version control.

# Google Gemini API Key (Required for scheme extraction and translation)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Tavily Search API Key (Required for live government scheme search)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_search_api_key_here

# FastAPI Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
DISCOVERY_TIMEOUT_SECONDS=45.0

